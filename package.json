{
  "name": "gabby-blueprint-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:ssl": "turbo run dev:ssl",
    "build": "turbo build",
    "lint": "node scripts/check-catalog.mjs && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0 .",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:vercel-env && pnpm --filter @gabby/testing unit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "clean": "turbo clean && rimraf node_modules",
    "vercel-env": "node scripts/vercel-env/run.mjs",
    "test:vercel-env": "node --test scripts/vercel-env/lib.test.mjs",
    "release:status": "node supabase/release/status.mjs",
    "env:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-env/export.ps1"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.6"
}
