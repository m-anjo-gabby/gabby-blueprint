{
  "name": "gabby-blueprint-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:ssl": "turbo run dev:ssl",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean && rimraf node_modules",
    "vercel-env": "node scripts/vercel-env/run.mjs",
    "test:vercel-env": "node --test scripts/vercel-env/lib.test.mjs",
    "env:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-env/export.ps1"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.23.13",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}