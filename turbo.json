{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/packages/**/node_modules/**"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:ssl": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/packages/**/node_modules/**"],
      "outputs": []
    }
  }
}
