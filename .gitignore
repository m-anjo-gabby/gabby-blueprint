# 全階層の node_modules を無視（先頭の / を取る）
node_modules/
.pnp
.pnp.*

# Next.js のビルド成果物を全階層で無視
.next/
out/

# 各種キャッシュやビルド成果物
build/
dist/
*.tsbuildinfo
next-env.d.ts

# OS & Debug
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
repomix-output.xml

# Env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Staging環境向け（自動テスト用途）: シークレットを含むためコミット禁止
.env.staging
.env.staging.local

# リリース作業用（supabase/release/run.mjs）: 接続情報・実行ログはコミット禁止
supabase/release/env/.env.*
!supabase/release/env/.env.example
supabase/release/logs/

# Github
.github

# Vercel
.vercel

# Turborepo
.turbo/

# Playwright/Cypress などのテスト結果（将来用）
test-results/
playwright-report/
blob-report/

# TypeScript 
# ※既に *.tsbuildinfo はありますが、念のため
.tsbuildinfo

# ログファイル
*.log

# 各パッケージ固有のキャッシュ
.eslintcache
.stylelintcache
.vercel

# --- Database Sync & Security ---
# 本番データを含む一時フォルダを丸ごと無視
temp_data/
# バックアップやダンプのログ
*.dump

# Github
.github

# Agents
.agents


# Claude Code（skills / settings.json はチーム共有。ローカル専用のものだけ除外）
.claude/worktrees/
.claude/settings.local.json

# Playwright E2E（ログイン状態・実行結果・trace。git管理しない）
testing/e2e/.auth/
testing/e2e/.artifacts/
