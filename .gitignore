# 全階層の node_modules を無視（先頭の / を取る）
node_modules/
.pnp
.pnp.*

# Next.js のビルド成果物を全階層で無視
.next/
out/

# 各種キャッシュやビルド成果物
build/
dist/
*.tsbuildinfo
next-env.d.ts

# OS & Debug
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
repomix-output.xml

# Env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# Turborepo
.turbo/

# Playwright/Cypress などのテスト結果（将来用）
test-results/
playwright-report/
blob-report/

# TypeScript 
# ※既に *.tsbuildinfo はありますが、念のため
.tsbuildinfo

# ログファイル
*.log

# 各パッケージ固有のキャッシュ
.eslintcache
.stylelintcache
.vercel

# --- Database Sync & Security ---
# 本番データを含む一時フォルダを丸ごと無視
temp_data/
# バックアップやダンプのログ
*.dump

# Github
.github
