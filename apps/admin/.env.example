# このファイルは apps/admin/.env.local のテンプレートです。
# 実際の値は Vercel CLI（vercel env pull）または担当者から取得し、.env.local（Git管理外）に設定してください。

# ============================================================
# Vercel CLI
# ============================================================
VERCEL_OIDC_TOKEN=

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# サイトURL（本アプリ自身のURLと、リダイレクト・代理ログインで参照する他アプリのURL）
# ============================================================
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COACH_URL=
NEXT_PUBLIC_STUDENT_URL=

# ============================================================
# Azure Speech Service（TTS/STT）
# ============================================================
AZURE_SPEECH_SERVICE_KEY=
AZURE_SPEECH_REGION=

# ============================================================
# Resend（メール送信）
# ============================================================
RESEND_API_KEY=
# 送信元（送信ドメイン認証したドメインのメールアドレスを指定）
MAIL_FROM_AUTH=
# 通知・リマインダーのメールの送信元（未設定なら MAIL_FROM_AUTH）
MAIL_FROM_NOTIFY=
# メール送信処理（/api/cron/mail-dispatch）の秘密のキー（Supabase Vault の mail_dispatch_secret と同じ値）
CRON_SECRET=
# 送信先ドメインの許可リスト（カンマ区切り。dev/staging は "resend.dev,gabbyacademy.com,gvtech.co.jp"、本番は空）
MAIL_DISPATCH_RECIPIENT_ALLOWLIST=
# 通知・リマインダーのメールの送信の範囲（all: 全員 / allowlist: 上の許可リストのドメインだけ / off: 送らない）。
# 未設定・不明な値は off（設定漏れで実在の人に送らないため）。dev/staging は allowlist、本番は all
MAIL_DISPATCH_MODE=
# Resend の Webhook（/api/webhooks/resend。メールの到達状況）の Signing Secret（whsec_...）。未設定なら Webhook を受け付けない
RESEND_WEBHOOK_SECRET=
# 運営向けのメール配信の日次の要約の宛先（カンマ区切り。送信失敗・不達・迷惑メールの報告・滞留があった日だけ 09:00 JST に送る。未設定なら送らない）
# dev は Resend のテスト用アドレス "delivered+ops-report@resend.dev"
MAIL_OPS_ALERT_TO=
# メールのログイン不要の配信停止リンクの署名鍵（admin・student・coach で同じ値。未設定なら配信停止リンク・List-Unsubscribe を付けない）
MAIL_UNSUBSCRIBE_SECRET=
# メールのヘッダーのロゴ画像の URL（未設定なら本番 https://blueprint.gabbyacademy.com/mail-logo.png。本番に未反映の画像を試す場合だけ指定）
MAIL_LOGO_URL=

# ============================================================
# Gemini（AI機能）
# ============================================================
GEMINI_API_KEY=
