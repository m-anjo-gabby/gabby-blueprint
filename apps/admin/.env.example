# このファイルは apps/admin/.env.local のテンプレートです（scripts/vercel-env/manifest.mjs から自動生成。直接編集しない）。
# 変数を追加・変更する場合は manifest.mjs を変更し、`node scripts/vercel-env/run.mjs --write-examples` で作り直してください。
# staging・本番の値は scripts/vercel-env/run.mjs で Vercel に反映します（scripts/vercel-env/README.md）。

# Vercel CLI（`vercel env pull` で入る。手で設定しない）
VERCEL_OIDC_TOKEN=

# ============================================================
# Supabase
# ============================================================
# Supabase のプロジェクトの URL（environments.mjs の supabaseRef から決まる）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の公開キー（ダッシュボード > Project Settings > API Keys）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase の service_role キー（サーバー専用。ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# サイトURL
# ============================================================
# 本アプリ自身の URL（パスワード再設定のメールのリンク等。environments.mjs の urls から決まる）
NEXT_PUBLIC_SITE_URL=
# 生徒のポータルの URL（招待・通知のメールのリンク、代理ログイン）
NEXT_PUBLIC_STUDENT_URL=
# コーチのポータルの URL（招待・通知のメールのリンク、代理ログイン）
NEXT_PUBLIC_COACH_URL=

# ============================================================
# Azure Speech Service（TTS/STT）
# ============================================================
# Azure Speech のキー
AZURE_SPEECH_SERVICE_KEY=
# Azure Speech のリージョン（例: japaneast）
AZURE_SPEECH_REGION=

# ============================================================
# Resend（メール送信）
# ============================================================
# Resend の API キー
RESEND_API_KEY=
# 招待・パスワード再設定のメールの送信元（送信ドメイン認証したドメインのアドレス）
MAIL_FROM_AUTH=
# 通知・リマインダーのメールの送信元（未設定なら MAIL_FROM_AUTH）
MAIL_FROM_NOTIFY=
# メール送信処理（/api/cron/mail-dispatch）の秘密のキー（Supabase Vault の mail_dispatch_secret と同じ値）
CRON_SECRET=
# 通知・リマインダーのメールの送信の範囲（all: 全員 / allowlist: 許可リストのドメインだけ / off: 送らない）。未設定・不明な値は off
MAIL_DISPATCH_MODE=
# MAIL_DISPATCH_MODE=allowlist のときの送信先ドメインの許可リスト（カンマ区切り）
MAIL_DISPATCH_RECIPIENT_ALLOWLIST=
# Resend の Webhook（/api/webhooks/resend。メールの到達状況）の Signing Secret。未設定なら Webhook を受け付けない
RESEND_WEBHOOK_SECRET=
# 運営向けのメール配信の日次の要約の宛先（カンマ区切り。毎日 09:00 JST に送る。問題が無い日も「異常なし」で送り、届くこと自体を送信処理の生存確認にする。未設定なら送らない）
MAIL_OPS_ALERT_TO=
# メールのログイン不要の配信停止リンクの署名鍵（3アプリで同じ値。未設定なら配信停止リンク・List-Unsubscribe を付けない）
MAIL_UNSUBSCRIBE_SECRET=
# メールのロゴ画像の URL（未設定なら本番 https://blueprint.gabbyacademy.com/mail-logo.png）。本番に未反映の画像を試す環境だけ指定
MAIL_LOGO_URL=

# ============================================================
# Gemini（AI機能）
# ============================================================
# Gemini の API キー
GEMINI_API_KEY=

# ============================================================
# ログ
# ============================================================
# サーバーのログの出力レベル（既定 info。trace / debug / info / warn / error）
LOG_LEVEL=
