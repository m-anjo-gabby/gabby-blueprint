# このファイルは apps/admin/.env.local のテンプレートです。
# 実際の値は Vercel CLI（vercel env pull）または担当者から取得し、.env.local（Git管理外）に設定してください。

# ============================================================
# Vercel CLI
# ============================================================
VERCEL_OIDC_TOKEN=

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# サイトURL（本アプリ自身のURLと、リダイレクト・代理ログインで参照する他アプリのURL）
# ============================================================
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COACH_URL=
NEXT_PUBLIC_STUDENT_URL=

# ============================================================
# Azure Speech Service（TTS/STT）
# ============================================================
AZURE_SPEECH_SERVICE_KEY=
AZURE_SPEECH_REGION=

# ============================================================
# Resend（メール送信）
# ============================================================
RESEND_API_KEY=
# 送信元（送信ドメイン認証したドメインのメールアドレスを指定）
MAIL_FROM_AUTH=
# 通知・リマインダーのメールの送信元（未設定なら MAIL_FROM_AUTH）
MAIL_FROM_NOTIFY=
# メール送信処理（/api/cron/mail-dispatch）の秘密のキー（Supabase Vault の mail_dispatch_secret と同じ値）
CRON_SECRET=
# 送信先ドメインの許可リスト（カンマ区切り。dev/staging は "resend.dev,gabbyacademy.com,gvtech.co.jp"、本番は空）
MAIL_DISPATCH_RECIPIENT_ALLOWLIST=

# ============================================================
# Gemini（AI機能）
# ============================================================
GEMINI_API_KEY=
