# このファイルは apps/student/.env.local のテンプレートです（scripts/vercel-env/manifest.mjs から自動生成。直接編集しない）。
# 変数を追加・変更する場合は manifest.mjs を変更し、`node scripts/vercel-env/run.mjs --write-examples` で作り直してください。
# staging・本番の値は scripts/vercel-env/run.mjs で Vercel に反映します（scripts/vercel-env/README.md）。

# Vercel CLI（`vercel env pull` で入る。手で設定しない）
VERCEL_OIDC_TOKEN=

# ============================================================
# Supabase
# ============================================================
# Supabase のプロジェクトの URL（environments.mjs の supabaseRef から決まる）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の公開キー（ダッシュボード > Project Settings > API Keys）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase の service_role キー（サーバー専用。ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# サイトURL
# ============================================================
# 本アプリ自身の URL（パスワード再設定のメールのリンク等。environments.mjs の urls から決まる）
NEXT_PUBLIC_SITE_URL=
# 管理画面の URL（Webトライアルの申込をサポート窓口へ知らせるメールの、申込一覧へのリンク）
NEXT_PUBLIC_ADMIN_URL=

# ============================================================
# Azure Speech Service（TTS/STT）
# ============================================================
# Azure Speech のキー
AZURE_SPEECH_SERVICE_KEY=
# Azure Speech のリージョン（例: japaneast）
AZURE_SPEECH_REGION=

# ============================================================
# Resend（メール送信）
# ============================================================
# Resend の API キー
RESEND_API_KEY=
# 招待・パスワード再設定のメールの送信元（送信ドメイン認証したドメインのアドレス）
MAIL_FROM_AUTH=
# Webトライアルの申込を知らせるメールの宛先（カンマ区切り。本番はサポート窓口 support@gabbyacademy.com。dev・staging は書いた場合だけ送る。未設定なら送らない（管理者へのアプリ内の通知は送る））
MAIL_TRIAL_APPLICATION_TO=
# メールのログイン不要の配信停止リンクの署名鍵（3アプリで同じ値。未設定なら配信停止リンク・List-Unsubscribe を付けない）
MAIL_UNSUBSCRIBE_SECRET=
# メールのロゴ画像の URL（未設定なら本番 https://blueprint.gabbyacademy.com/mail-logo.png）。本番に未反映の画像を試す環境だけ指定
MAIL_LOGO_URL=

# ============================================================
# Webトライアル
# ============================================================
# Webトライアルの申込（/trial）を受け付けるか（true / false）。false・未設定なら /trial・/trial/complete は 404、申込のアクションも受け付けない。本番は試験運用の間 false
TRIAL_APPLICATION_ENABLED=

# ============================================================
# 今日のトレーニングメニュー
# ============================================================
# ホームの主役に今日のトレーニングメニューを出すか（true / false）。false・未設定ならメニューを作らず、教材・お気に入りへの案内を出す。本番は試験運用の間 false
TRAINING_MENU_ENABLED=

# ============================================================
# Cloudflare Turnstile
# ============================================================
# Webトライアルの申込フォーム（/trial）の CAPTCHA のサイトキー。dev・staging・手元は Cloudflare のテスト用キー（常に通る）。本番は Cloudflare の Turnstile で blueprint.gabbyacademy.com 用に作ったキー
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile の秘密鍵（サーバーでの検証用。未設定なら申込を受け付けない）。dev・staging・手元はテスト用の鍵（常に通る）
TURNSTILE_SECRET_KEY=

# ============================================================
# Cloudflare R2（ビデオ教材のファイル）
# ============================================================
# Cloudflare のアカウント ID（R2 の概要の画面の Account ID。全環境で同じ）
R2_ACCOUNT_ID=
# R2 の API トークンの Access Key ID（環境ごとに、その環境のバケットだけの Object Read & Write）
R2_ACCESS_KEY_ID=
# R2 の API トークンの Secret Access Key（トークンの作成時に一度だけ表示される）
R2_SECRET_ACCESS_KEY=
# ビデオ教材の動画・サムネイルを置くバケット（環境ごとに決まる）
R2_VIDEO_BUCKET=

# ============================================================
# Zoom Video SDK（ライブセッション）
# ============================================================
# Zoom Video SDK のキー
ZOOM_VIDEO_SDK_KEY=
# Zoom Video SDK の秘密のキー
ZOOM_VIDEO_SDK_SECRET=

# ============================================================
# 検証用の上書き（本番は設定しない）
# ============================================================
# ライブセッションの終了予告までの分数（既定 25）
NEXT_PUBLIC_LIVE_SESSION_WARNING_MINUTES=
# ライブセッションの自動終了までの分数（既定 30）
NEXT_PUBLIC_LIVE_SESSION_END_MINUTES=
# ライブセッションに開始前から入室できる分数（既定 5）
NEXT_PUBLIC_LIVE_SESSION_EARLY_JOIN_MINUTES=
# 音声認識の方式。"fake" でテスト用の認識に切り替える（本番では絶対に設定しない）
NEXT_PUBLIC_SPEECH_RECOGNIZER=

# ============================================================
# ログ
# ============================================================
# サーバーのログの出力レベル（既定 info。trace / debug / info / warn / error）
LOG_LEVEL=
