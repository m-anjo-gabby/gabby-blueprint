{
  "name": "@gabby/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:android": "cross-env E2E_ANDROID=1 playwright test",
    "e2e:staging": "cross-env E2E_ENV=staging playwright test",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "e2e:preflight:coach": "tsx e2e/support/coachE2e.preflight.ts",
    "e2e:preflight:coach:staging": "tsx e2e/support/coachE2e.preflight.ts --env=staging",
    "unit": "tsx --test unit/*.test.ts"
  },
  "dependencies": {
    "@gabby/lib": "workspace:*",
    "@supabase/supabase-js": "^2.94.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
