# =========================================================================
# テスト専用の環境変数（testing/helpers/env.ts の loadTestEnv() が自動で読み込む）
#
# 本ファイルをコピーして testing/.env.local を作成し、値を設定する（.env.local はGit管理外）。
# Supabaseの接続情報は apps/student/.env.local（dev）/ .env.staging（staging）から読むため、
# ここにはテスト固有の値だけを置く。シェルで同名の環境変数を渡した場合はそちらが優先される。
# =========================================================================

# QAアカウント（*@gabby-qa-test.example、testing/FIXTURES.md）の共通パスワード
QA_LIVE_SESSION_TEST_PASSWORD=

# Resend の送信済みメールを読み取るための API キー（Full access）。メール受信のE2E（e2e/support/resendInbox.ts）で使う。
# アプリの RESEND_API_KEY は送信専用で読み取れないため、別に発行する。未設定ならメール受信のテストはスキップされる。
RESEND_TEST_READ_API_KEY=
