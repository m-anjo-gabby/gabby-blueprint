# =========================================================================
# リリース作業用 環境ファイルのテンプレート（supabase/release/run.mjs が読み込む）
#
# 本ファイルをコピーして同じディレクトリに以下の名前で作成する（いずれもGit管理外）:
#   .env.dev / .env.staging / .env.prod
#
# アプリ用の apps/*/.env.local / .env.staging とは分けて管理する
# （リリースに不要なキー（Azure・Resend等）を持たせないため）。
# =========================================================================

# 対象プロジェクトのReference ID（ダッシュボード > Project Settings > General）
# 例: dev=vihincuxiizavuxoctul / staging=vodmgorcugymrpdmdqkg / prod=xzoefwwzminkqqzbhtwq
SUPABASE_PROJECT_REF=

# SQL実行（Management API）用の個人アクセストークン
# ダッシュボード右上のアカウント > Access Tokens で発行（Free/Prod両組織に権限のあるアカウントで発行）。
# Permissions は Database: Read-write と Project Settings: Read のみ（Full Access は不要。README.md 参照）。
# アカウント配下の全プロジェクトを操作できる強い権限のため、.env.prod では空欄にしておき
# 実行時に入力する運用を推奨する（空欄の場合、run.mjs が実行時に入力を求める）。
SUPABASE_ACCESS_TOKEN=

# 適用後スクリプト（-- @post）用。apps/*/.env.* と同じ値でよい。
# SUPABASE_URL は https://<SUPABASE_PROJECT_REF>.supabase.co と一致している必要がある（不一致なら実行を中止する）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
